# Downloaded corpus (large, regenerable) — PDFs/reports/backups stay ignored,
# but the per-bank manifests (data/manifest/<bank>.jsonl) ARE committed so the
# corpus metadata is versioned and replayable.
data/*
!data/manifest/
data/manifest/*
!data/manifest/*.jsonl
# committed date-recovery index (run-once, replay-forever — DATE_RECOVERY.md)
!data/wp_dates_index.jsonl

# Cadence watchdog — derived operational state, regenerated weekly.
data/cadence.jsonl
data/cadence_state.jsonl

# Orphan sweep quarantine tree (already covered by data/* above; explicit for clarity).
data/raw_orphans/

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.venv/
venv/

# IDE / OS
.DS_Store
.idea/
.vscode/
*.swp

# Local-only sensitive notes (infra details, credentials pointers) — NEVER committed.
*.local.md

# Docs — generated snapshots (regenerate via the scripts) + local working/analysis notes.
# Committed docs: README, INGESTION_RAG, BANKS, deploy/README, docs/*.md.
CORPUS.md
PRESENTATION.md
PRESENTATION_EN.md
*.pptx
ARCHITECTURE.md
DISCOVERY_AUDIT.md
COMPLETENESS.md
ECB_DOC_TYPES.md

# SDD scratch (ledger, briefs) — never committed
.superpowers/

# Superpowers process artifacts (specs/plans) — kept outside this repository
docs/superpowers/
